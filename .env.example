# Railway Postgres provides DATABASE_URL when the database service is linked.
DATABASE_URL=
DATABASE_SSL=false

# Generate a unique value with: node -e "console.log(require('node:crypto').randomBytes(48).toString('base64url'))"
AUTH_SECRET=

# OpenRouter API key; choose the free-only model router to avoid paid model calls.
# Never use a NEXT_PUBLIC_ prefix for this value.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free

# Optional: notify the site owner after each new signup (uses Resend).
RESEND_API_KEY=
CONTACT_EMAIL=
# For production, use a sender address/domain verified with Resend.
RESEND_FROM_EMAIL=

# Optional stock quote provider key.
ALPHA_VANTAGE_API_KEY=
